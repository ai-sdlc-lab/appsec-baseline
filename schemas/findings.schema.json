{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-sdlc-lab/appsec-baseline/schemas/findings.schema.json",
  "title": "Reviewer output",
  "description": "Output every reviewer returns (local stage loop and the dormant CI path). Validated by stage/validate.py and gate/security_gate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewer",
    "findings"
  ],
  "properties": {
    "reviewer": {
      "type": "string",
      "enum": [
        "intent-completeness",
        "spec-completeness",
        "architecture-conformance",
        "security-requirements-auditor",
        "security-architect",
        "security-code-reviewer",
        "workflow-iac-reviewer",
        "security-tester"
      ]
    },
    "artifact": {
      "description": "TRACE-/THREAT- markdown the reviewer produces; written by stage/write_artifact.py. Omitted by other reviewers.",
      "type": "string",
      "maxLength": 262144
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "maxItems": 200
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reviewer",
        "severity",
        "sr_ref",
        "file",
        "line",
        "evidence",
        "recommendation",
        "blocking"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{3}$",
          "description": "Unique within this output, e.g. AUD-001"
        },
        "reviewer": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "category": {
          "type": "string",
          "description": "Optional. 'prompt-injection' when an artifact contains instructions aimed at reviewers; the gate escalates these to a human.",
          "maxLength": 40
        },
        "sr_ref": {
          "type": "string",
          "pattern": "^(SR-[0-9]{3}|NEW|N/A)$",
          "description": "Requirement violated or missing; NEW when no requirement covers it; N/A only for non-security reviewers"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$))[A-Za-z0-9._/-]+$"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000000
        },
        "evidence": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000,
          "description": "Quote or concrete proof. Required."
        },
        "recommendation": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "blocking": {
          "type": "boolean"
        },
        "needs_human": {
          "type": "boolean",
          "description": "Only the owner can supply the fact (product decision)."
        },
        "pre_existing": {
          "type": "boolean",
          "description": "true when the gap already exists on main in code or behaviour this change doesn't alter (old debt). Deferred to a GitHub issue; it doesn't block the change."
        }
      }
    }
  }
}
