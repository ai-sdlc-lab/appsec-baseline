{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-sdlc-lab/appsec-baseline/schemas/sr-exceptions.schema.json",
  "title": "Accepted security-requirement risks",
  "description": "A product repository's own exceptions file, security/exceptions.yml (one per repository). Exceptions don't expire (owner decision 2026-11-02). Agents may add entries only for low/medium findings, approved_by 'agent'; every entry reaches main only through the owner's merge. Path rules are checked by stage/exceptions.py.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "sr",
      "paths",
      "reason",
      "approved_by",
      "approved"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^EXC-[0-9]{3}$"
      },
      "sr": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^(SR-[0-9]{3}|NEW)$"
        }
      },
      "finding_id": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]{3}$"
      },
      "paths": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/*-]{1,300}$"
        }
      },
      "reason": {
        "type": "string",
        "minLength": 10,
        "maxLength": 1000
      },
      "approved_by": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]{1,39}$",
        "description": "'agent' for entries the SDLC workflow adds, else the owner's GitHub login"
      },
      "approved": {
        "type": "string",
        "format": "date"
      }
    }
  }
}
